{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mangareader",
  "version": "0.1.0",
  "identifier": "com.mangareader.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MangaReader 漫画阅读器",
        "width": 1200,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../ocr/ocr_server.py": "ocr/ocr_server.py", "../ocr/ocr_layout.py": "ocr/ocr_layout.py", "../ocr/tencent_bridge.py": "ocr/tencent_bridge.py", "../ocr/requirements.txt": "ocr/requirements.txt", "../ocr/setup-ocr.cmd": "ocr/setup-ocr.cmd", "../ocr/start-ocr.cmd": "ocr/start-ocr.cmd" },
    "fileAssociations": [
      {
        "ext": ["pdf", "cbz", "zip", "cbr", "rar"],
        "name": "MangaReader 漫画",
        "description": "使用 MangaReader 打开漫画或 PDF",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
